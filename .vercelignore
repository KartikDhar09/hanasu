# Allowlist: publish only what the app needs. Anything else (scripts, CI config, docs, new files) stays private.
/*
!/index.html
!/login.html
# Login wall: the middleware and the /api functions run on Vercel's servers; they are never served as files.
!/middleware.js
!/api
!/sw.js
!/manifest.webmanifest
!/robots.txt
!/icon.svg
!/icon-180.png
!/icon-192.png
!/icon-512.png
!/js
!/css
!/audio
!/img
!/strokes
!/vercel.json
